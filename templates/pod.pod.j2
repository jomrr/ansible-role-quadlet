# Managed by Ansible.

[Unit]
Description={{ quadlet_pod.description | default('Rootless Podman pod ' ~ __quadlet_pod_name) }}
After=network-online.target
Wants=network-online.target

[Pod]
{% if quadlet_pod.pod_name is defined %}
PodName={{ quadlet_pod.pod_name }}
{% endif %}
{% if quadlet_pod.service_name is defined %}
ServiceName={{ quadlet_pod.service_name }}
{% endif %}
ExitPolicy={{ quadlet_pod.exit_policy | default('stop') }}
{% if quadlet_pod.hostname is defined %}
HostName={{ quadlet_pod.hostname }}
{% endif %}
{% for add_host in quadlet_pod.add_hosts | default([]) %}
AddHost={{ add_host }}
{% endfor %}
{% for dns_server in quadlet_pod.dns | default([]) %}
DNS={{ dns_server }}
{% endfor %}
{% for dns_option in quadlet_pod.dns_options | default([]) %}
DNSOption={{ dns_option }}
{% endfor %}
{% for dns_domain in quadlet_pod.dns_search | default([]) %}
DNSSearch={{ dns_domain }}
{% endfor %}
{% for label in quadlet_pod.labels | default([]) %}
{% if label is mapping %}
Label={{ label.key }}={{ label.value }}
{% else %}
Label={{ label }}
{% endif %}
{% endfor %}
{% for network in quadlet_pod.networks | default([]) %}
{% if network is mapping %}
Network={{ network.name }}
{% else %}
Network={{ network }}
{% endif %}
{% endfor %}
{% for network_alias in quadlet_pod.network_aliases | default([]) %}
NetworkAlias={{ network_alias }}
{% endfor %}
{% for port in quadlet_pod.ports | default([]) %}
{% if port is mapping %}
{% set publish_host_ip = (port.host_ip ~ ':') if port.host_ip is defined else '' %}
{% set publish_host_port = port.host_port | default(port.published | default('')) %}
{% set publish_container_port = port.container_port | default(port.target | default('')) %}
PublishPort={{ publish_host_ip }}{{ publish_host_port }}:{{ publish_container_port }}{% if port.protocol is defined %}/{{ port.protocol }}{% endif %}
{% else %}
PublishPort={{ port }}
{% endif %}
{% endfor %}
{% for volume in quadlet_pod.volumes | default([]) %}
{% if volume is mapping %}
{% set volume_source = volume.source | default(volume.src | default('')) %}
{% set volume_target = volume.target | default(volume.dest | default(volume.destination | default(''))) %}
{% if volume.options is defined %}
{% set volume_options = volume.options if volume.options is string else volume.options | join(',') %}
Volume={{ volume_source }}:{{ volume_target }}:{{ volume_options }}
{% else %}
Volume={{ volume_source }}:{{ volume_target }}
{% endif %}
{% else %}
Volume={{ volume }}
{% endif %}
{% endfor %}
{% if quadlet_pod.shm_size is defined %}
ShmSize={{ quadlet_pod.shm_size }}
{% endif %}
{% if quadlet_pod.userns is defined %}
UserNS={{ quadlet_pod.userns }}
{% endif %}
{% for uid_map in quadlet_pod.uid_maps | default([]) %}
UIDMap={{ uid_map }}
{% endfor %}
{% for gid_map in quadlet_pod.gid_maps | default([]) %}
GIDMap={{ gid_map }}
{% endfor %}
{% if quadlet_pod.subuid_map is defined %}
SubUIDMap={{ quadlet_pod.subuid_map }}
{% endif %}
{% if quadlet_pod.subgid_map is defined %}
SubGIDMap={{ quadlet_pod.subgid_map }}
{% endif %}

[Service]
{% for command in quadlet_pod.exec_start_pre | default([]) %}
ExecStartPre={{ command }}
{% endfor %}
Restart={{ quadlet_pod.restart_policy | default('always') }}
{% if quadlet_pod.restart_sec is defined %}
RestartSec={{ quadlet_pod.restart_sec }}
{% endif %}
{% if quadlet_pod.timeout_start_sec is defined %}
TimeoutStartSec={{ quadlet_pod.timeout_start_sec }}
{% endif %}

[Install]
{% set quadlet_wanted_by = quadlet_pod.wanted_by | default('default.target') %}
{% if quadlet_wanted_by is sequence and quadlet_wanted_by is not string %}
{% for target in quadlet_wanted_by %}
WantedBy={{ target }}
{% endfor %}
{% else %}
WantedBy={{ quadlet_wanted_by }}
{% endif %}
