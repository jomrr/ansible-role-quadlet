{% from '_macros.j2' import render_options %}
# Managed by Ansible.

[Unit]
Description=Rootless Podman container {{ __quadlet_container.name }}
{{ render_options(__quadlet_container.unit_options | default({})) }}
[Container]
Image={{ __quadlet_container.image }}
ContainerName={{ __quadlet_container.container_name | default(__quadlet_container.name) }}
{% if __quadlet_container.pod is defined %}
{% set quadlet_container_pod = __quadlet_container.pod | string %}
Pod={{ quadlet_container_pod if quadlet_container_pod | regex_search('\.pod$') else quadlet_container_pod ~ '.pod' }}
StartWithPod={{ (__quadlet_container.start_with_pod | default(true) | bool) | ternary('true', 'false') }}
{% endif %}
EnvironmentFile={{ __quadlet_container.environment_file }}
{% for secret in __quadlet_container.secrets %}
{% set secret_type = secret.type | default('mount') %}
{% if secret_type == 'env' %}
Secret={{ secret.name }},type=env,target={{ secret.env_target }}
{% elif secret.target is defined %}
Secret={{ secret.name }},target={{ secret.target }}
{% else %}
Secret={{ secret.name }}
{% endif %}
{% endfor %}
{% for volume in __quadlet_container.volumes | default([]) %}
Volume={{ volume }}
{% endfor %}
{% for port in __quadlet_container.ports | default([]) %}
PublishPort={{ port }}
{% endfor %}
{% for network in __quadlet_container.networks | default([]) %}
Network={{ network }}
{% endfor %}
ReadOnly={{ (__quadlet_container.read_only | default(true) | bool) | ternary('true', 'false') }}
ReadOnlyTmpfs={{ (__quadlet_container.read_only_tmpfs | default(true) | bool) | ternary('true', 'false') }}
NoNewPrivileges={{ (__quadlet_container.no_new_privileges | default(true) | bool) | ternary('true', 'false') }}
{% for capability in __quadlet_container.drop_capabilities | default(['all']) %}
DropCapability={{ capability }}
{% endfor %}
PidsLimit={{ __quadlet_container.pids_limit | default(512) }}
{% for tmpfs in __quadlet_container.tmpfs | default([]) %}
Tmpfs={{ tmpfs }}
{% endfor %}
{% if __quadlet_container.exec is defined %}
Exec={{ __quadlet_container.exec }}
{% endif %}
AutoUpdate={{ __quadlet_container.auto_update | default(quadlet_autoupdate) }}
{{ render_options(__quadlet_container.container_options | default({})) }}
[Service]
Restart={{ __quadlet_container.restart_policy | default('always') }}
{{ render_options(__quadlet_container.service_options | default({})) }}
[Install]
{% if __quadlet_container.enabled | default(true) | bool and 'WantedBy' not in (__quadlet_container.install_options | default({})) %}
WantedBy=default.target
{% endif %}
{{ render_options(__quadlet_container.install_options | default({})) -}}
